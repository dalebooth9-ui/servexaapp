[
  {
    "name": "Fire Hydrant \u2014 Annual Inspection",
    "fields": [
      {
        "id": "hydrant_type",
        "type": "select",
        "label": "Hydrant Type",
        "options": [
          "Surface Box",
          "Pillar Hydrant",
          "Underground",
          "Wet Riser Outlet",
          "Dry Riser Outlet"
        ]
      },
      {
        "id": "hydrant_reference",
        "type": "text",
        "label": "Hydrant Reference / ID"
      },
      {
        "id": "location",
        "type": "text",
        "label": "Location / Address"
      },
      {
        "id": "valve_condition",
        "type": "select",
        "label": "Valve Condition",
        "options": [
          "Good",
          "Stiff",
          "Seized",
          "Damaged"
        ]
      },
      {
        "id": "outlet_cap_condition",
        "type": "select",
        "label": "Outlet Cap / Blank Condition",
        "options": [
          "Good",
          "Missing",
          "Damaged"
        ]
      },
      {
        "id": "flow_test",
        "type": "checkbox",
        "label": "Flow Test Carried Out",
        "allow_notes": true
      },
      {
        "id": "static_pressure",
        "type": "text",
        "label": "Static Pressure at Outlet (bar)"
      },
      {
        "id": "flow_rate",
        "type": "text",
        "label": "Flow Rate (l/min)"
      },
      {
        "id": "marker_post_condition",
        "type": "select",
        "label": "Marker Post / Plate Condition",
        "options": [
          "Good",
          "Missing",
          "Damaged",
          "Not Required"
        ]
      },
      {
        "id": "access_clear",
        "type": "select",
        "label": "Access / Approach Clear",
        "options": [
          "Yes",
          "No \u2014 Obstruction Present"
        ]
      },
      {
        "id": "remedial_action",
        "type": "textarea",
        "label": "Remedial Action Required"
      },
      {
        "id": "result",
        "type": "select",
        "label": "Overall Result",
        "options": [
          "Pass",
          "Fail",
          "Requires Remedial Work"
        ]
      }
    ]
  },
  {
    "name": "Wet Riser \u2014 Annual Service & Test",
    "fields": [
      {
        "id": "site_name",
        "type": "text",
        "label": "Site Name",
        "section": "Site Details",
        "required": true
      },
      {
        "id": "site_address",
        "type": "textarea",
        "label": "Site Address",
        "section": "Site Details",
        "required": true
      },
      {
        "id": "reference",
        "type": "text",
        "label": "Reference / Job Number",
        "section": "Site Details",
        "required": true
      },
      {
        "id": "date",
        "type": "date",
        "label": "Inspection Date",
        "section": "Site Details",
        "required": true
      },
      {
        "id": "engineer",
        "type": "text",
        "label": "Engineer Name",
        "section": "Site Details",
        "required": true
      },
      {
        "id": "system_ref",
        "type": "text",
        "label": "System Reference",
        "section": "System Details",
        "required": true
      },
      {
        "id": "no_of_landing_valves",
        "type": "number",
        "label": "Number of Landing Valves",
        "section": "System Details",
        "required": true
      },
      {
        "id": "pump_set",
        "type": "text",
        "label": "Pump Set Manufacturer / Model",
        "section": "System Details",
        "required": false
      },
      {
        "id": "pump_start_test",
        "type": "pass_fail",
        "label": "Pump Auto-Start Test",
        "section": "Pump Checks",
        "required": true
      },
      {
        "id": "pump_duty_pressure",
        "type": "number",
        "label": "Pump Duty Pressure (bar)",
        "section": "Pump Checks",
        "required": true
      },
      {
        "id": "pump_standby_ok",
        "type": "checkbox",
        "label": "Standby Pump Operational",
        "section": "Pump Checks",
        "required": true,
        "allow_notes": true
      },
      {
        "id": "jockey_pump_ok",
        "type": "checkbox",
        "label": "Jockey Pump Operational",
        "section": "Pump Checks",
        "required": true,
        "allow_notes": true
      },
      {
        "id": "tank_level",
        "type": "checkbox",
        "label": "Break Tank Level Adequate",
        "section": "Pump Checks",
        "required": true,
        "allow_notes": true
      },
      {
        "id": "landing_valves_ok",
        "type": "checkbox",
        "label": "All Landing Valves Operational",
        "section": "Landing Valve Checks",
        "required": true,
        "allow_notes": true
      },
      {
        "id": "hose_reels_ok",
        "type": "checkbox",
        "label": "Hose Reels Present & Serviceable",
        "section": "Landing Valve Checks",
        "required": true,
        "allow_notes": true
      },
      {
        "id": "signage_ok",
        "type": "checkbox",
        "label": "Signage Correct & Visible",
        "section": "Landing Valve Checks",
        "required": true,
        "allow_notes": true
      },
      {
        "id": "test_pressure",
        "type": "number",
        "label": "System Test Pressure (bar)",
        "section": "Pressure Test",
        "required": true
      },
      {
        "id": "test_duration",
        "type": "number",
        "label": "Duration (minutes)",
        "section": "Pressure Test",
        "required": true
      },
      {
        "id": "pressure_drop",
        "type": "number",
        "label": "Pressure Drop (bar)",
        "section": "Pressure Test",
        "required": true
      },
      {
        "id": "overall_result",
        "type": "pass_fail",
        "label": "Overall Result",
        "section": "Result",
        "required": true
      },
      {
        "id": "remedial_required",
        "type": "checkbox",
        "label": "Remedial Action Required",
        "section": "Result",
        "required": true,
        "allow_notes": true
      },
      {
        "id": "comments",
        "type": "textarea",
        "label": "Comments / Defects",
        "section": "Result",
        "required": false
      },
      {
        "id": "bs_declaration",
        "type": "checkbox",
        "label": "This service has been carried out in accordance with BS 9990:2015 \u2014 Code of Practice for the Use of Fire-Fighting Water Systems (Wet Riser)",
        "section": "Declaration",
        "required": true,
        "allow_notes": true
      }
    ]
  },
